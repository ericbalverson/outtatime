# Postgres connection string (Neon on Vercel). Leave unset locally to use the
# embedded PGlite database stored in ./.pglite
DATABASE_URL=

# Generate with: npx auth secret   (or any long random string)
AUTH_SECRET=

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Local development only: shows a "Dev login" button so you can try the app
# without Google. Ignored in production builds.
DEV_LOGIN=true
